        "validation/validate_r3947_footer_runtime_guard.py": ["UX_VERSION", "package.json"]
      }
    },
    "branding": {
      "owner": "validation/validate_branding_assets.py",
      "owns": ["canonical artwork", "brand delivery", "source/dist parity"],
      "forbidden_in": {
        "validation/validate_shared_ux_footer.py": ["company-logo.svg", "COMPANY_LOGO", "package-versioned URL"]
      }
    },
    "footer_presentation": {
      "owner": "validation/validate_shared_ux_footer.py",
