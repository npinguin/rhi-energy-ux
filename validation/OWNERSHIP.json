      "forbidden_in": {
        "validation/validate_r3942_flow_contract.py": ["UX_VERSION", "package.json"],
        "validation/validate_r3943_consumption_truth.py": ["UX_VERSION", "package.json"],
        "validation/validate_r3944_stable_refresh.py": ["UX_VERSION", "package.json"],
