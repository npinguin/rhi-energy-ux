{
  "version": 1,
  "principle": "one source concern, one owner",
  "owners": {
    "app": {
      "path": "src/app",
      "owns": ["Energy custom element", "shared shell", "navigation", "renderers", "package asset references"]
    },
    "runtime": {
      "path": "src/runtime",
      "owns": ["Home Assistant public Energy contract registry/gateway", "contract readers", "command contract boundary"]
    },
    "domain_models": {
      "path": "src/domain/models",
      "owns": ["canonical Energy UX view models", "metering model", "flexible-asset domain model"]
    },
    "planning": {
      "path": "src/domain/planning",
      "owns": ["planning contract adaptation", "planning contract reader", "planning view model"]
    },
    "assets": {
      "path": "src/assets",
      "owns": ["canonical package artwork grouped by public asset category"]
    },
    "package": {
      "path": "tools/build.py",
      "owns": ["source manifest consumption", "module injection", "bundle generation", "dist package assembly", "package manifest generation"]
    }
  }
}
